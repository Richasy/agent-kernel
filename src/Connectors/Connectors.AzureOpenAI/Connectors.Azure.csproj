<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>Richasy.AgentKernel.Connectors.Azure</AssemblyName>
	<RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
	<NoWarn>$(NoWarn)</NoWarn>
	<IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Import Project="$(RepoRoot)/src/nuget-package.props" />
  
  <PropertyGroup>
  	<!-- NuGet Package Settings -->
  	<Title>Agent Kernel - Azure connectors</Title>
  	<Description>Agent Kernel connectors for Azure Clound, include AzureOpenAI/TTS/Translate services</Description>
  </PropertyGroup>
  
  <ItemGroup>
	<PackageReference Include="RichasyKernel.Abstractions" />
	<PackageReference Include="RichasyKernel.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgentKernel.Core\AgentKernel.Core.csproj" />
    <ProjectReference Include="..\..\Libs\AgentKernel.Core.AzureInference\AgentKernel.Core.AzureInference.csproj" />
	<ProjectReference Include="..\..\Libs\AgentKernel.Core.AzureOpenAI\AgentKernel.Core.AzureOpenAI.csproj" />
	<ProjectReference Include="..\..\Libs\AgentKernel.Extensions.AI.AzureAIInference\AgentKernel.Extensions.AI.AzureAIInference.csproj" />
	<ProjectReference Include="..\..\Libs\AgentKernel.Extensions.AI.OpenAI\AgentKernel.Extensions.AI.OpenAI.csproj" />
  </ItemGroup>
</Project>
