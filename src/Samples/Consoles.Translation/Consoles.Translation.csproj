<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
	<TrimmerSingleWarn>false</TrimmerSingleWarn>
	<NoWarn>$(NoWarn);IL2067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  	<PackageReference Include="Microsoft.Extensions.Hosting" />
  	<PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Connectors\Connectors.Ali\Connectors.Ali.csproj" />
    <ProjectReference Include="..\..\Connectors\Connectors.AzureOpenAI\Connectors.Azure.csproj" />
    <ProjectReference Include="..\..\Connectors\Connectors.Baidu\Connectors.Baidu.csproj" />
    <ProjectReference Include="..\..\Connectors\Connectors.Google\Connectors.Google.csproj" />
    <ProjectReference Include="..\..\Connectors\Connectors.Tencent\Connectors.Tencent.csproj" />
    <ProjectReference Include="..\..\Connectors\Connectors.Volcano\Connectors.Volcano.csproj" />
    <ProjectReference Include="..\..\Connectors\Connectors.Youdao\Connectors.Youdao.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="env.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
