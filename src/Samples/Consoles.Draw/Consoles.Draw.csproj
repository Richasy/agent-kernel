<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  	<OutputType>Exe</OutputType>
  	<TargetFramework>net9.0</TargetFramework>
  	<ImplicitUsings>enable</ImplicitUsings>
  	<Nullable>enable</Nullable>
  	<TrimmerSingleWarn>false</TrimmerSingleWarn>
  	<InvariantGlobalization>true</InvariantGlobalization>
  	<NoWarn>$(NoWarn);IL2067;NU1900</NoWarn>
  	<PublishAot>true</PublishAot>
  </PropertyGroup>
  
  <ItemGroup>
  	<PackageReference Include="Microsoft.Extensions.Hosting" />
  	<PackageReference Include="Spectre.Console" />
  </ItemGroup>
  
  <ItemGroup>
  	<ProjectReference Include="..\..\Connectors\Connectors.AzureOpenAI\Connectors.Azure.csproj" />
  	<ProjectReference Include="..\..\Connectors\Connectors.Baidu\Connectors.Baidu.csproj" />
  </ItemGroup>
  
  <ItemGroup>
  	<None Update="env.json">
  		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  	</None>
  </ItemGroup>

</Project>
